# TRDeFi x thirdweb — environment template
# Copy values from the txt files in ./keys/ into Netlify env (never commit real keys).
# Frontend may ONLY use THIRDWEB_CLIENT_ID (publishable). Everything else is server-side.

# Publishable — safe for browser (thirdweb dashboard → project → client ID)
THIRDWEB_CLIENT_ID=paste-client-id-here

# Server-side only — Netlify env / function config, NEVER in frontend code
OPENROUTER_API_KEY=paste-from-keys-openrouter-key-txt
THIRDWEB_SECRET_KEY=paste-server-secret-here

# Optional
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=
AI_DAILY_LIMIT_PER_IP=20
